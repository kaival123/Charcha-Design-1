# Apache config for the Charchalive single-page app.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and folders (images, scripts, api/contact.php) as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is an app route (e.g. /team/pradip-bagchi): let Angular handle it.
  RewriteRule ^ index.html [L]
</IfModule>
